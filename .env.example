NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Table Names (defaults to workspaces, members, projects, tasks, images)
# NEXT_PUBLIC_SUPABASE_DATABASE_ID=public
# NEXT_PUBLIC_SUPABASE_WORKSPACES_ID=workspaces
# NEXT_PUBLIC_SUPABASE_MEMBERS_ID=members
# NEXT_PUBLIC_SUPABASE_PROJECTS_ID=projects
# NEXT_PUBLIC_SUPABASE_TASKS_ID=tasks
# NEXT_PUBLIC_SUPABASE_IMAGES_BUCKET_ID=images

# AI Features (Groq API)
GROQ_API_KEY=your-groq-api-key
